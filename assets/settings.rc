#pragma code_page(65001)
#include <windows.h>

2 DIALOGEX 0, 0, 298, 256
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VTD - Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Keyboard shortcuts", -1, 12, 10, 274, 94
    LTEXT "&Hold to record:", 1011, 22, 29, 136, 12
    CONTROL "", 1001, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 160, 26, 114, 14
    LTEXT "&Start / stop recording:", -1, 22, 53, 136, 12
    CONTROL "", 1002, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 160, 50, 114, 14
    LTEXT "&Insert last transcript:", -1, 22, 77, 136, 12
    CONTROL "", 1003, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 160, 74, 114, 14
    LTEXT "Speech &language:", -1, 14, 119, 94, 12
    COMBOBOX 1004, 112, 116, 174, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Start when I sign in to &Windows", 1005, 14, 147, 272, 14, WS_TABSTOP
    AUTOCHECKBOX "&Mute playback while recording", 1006, 14, 171, 272, 14, WS_TABSTOP
    LTEXT "Click a shortcut field and press the key or combination. Shortcuts are paused while this window is open.", -1, 14, 195, 272, 24
    DEFPUSHBUTTON "&Save", IDOK, 158, 228, 60, 17, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 226, 228, 60, 17, WS_TABSTOP
END
