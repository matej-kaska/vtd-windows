+    {
+        const auto decode_original = [](const ggml_tensor * tensor) {
+            std::vector<uint8_t> raw(ggml_nbytes(tensor));
+            ggml_backend_tensor_get(tensor, raw.data(), 0, raw.size());
+            std::vector<float> expanded(static_cast<size_t>(ggml_nelements(tensor)));
+            if (tensor->type == GGML_TYPE_F32) {
+                std::memcpy(expanded.data(), raw.data(), raw.size());
+            } else {
+                ggml_get_type_traits(tensor->type)->to_float(raw.data(), expanded.data(), ggml_nelements(tensor));
+            }
+            return expanded;
+        };
+        const auto check_mirror = [&](const ggml_tensor * original, const ggml_tensor * mirror) {
+            CHECK(mirror != nullptr);
+            if (mirror == nullptr) {
+                return;
+            }
+            const auto expected = decode_original(original);
+            CHECK(ggml_nelements(mirror) == static_cast<int64_t>(expected.size()));
+            if (ggml_nelements(mirror) == static_cast<int64_t>(expected.size())) {
+                const auto actual = decode_original(mirror);
+                CHECK(std::memcmp(expected.data(), actual.data(), actual.size() * sizeof(float)) == 0);
+            }
+        };
+        const auto & cache = pm->host_decoder;
+        CHECK(cache.predictor.lstm_ready);
+        CHECK(cache.joint.w_ready);
+        for (size_t i = 0; i < cache.predictor.lstm.size(); ++i) {
+            check_mirror(pm->weights.predictor.lstm[i].Wx, cache.predictor.lstm[i].g_Wx);
+            check_mirror(pm->weights.predictor.lstm[i].Wh, cache.predictor.lstm[i].g_Wh);
+            check_mirror(pm->weights.predictor.lstm[i].b, cache.predictor.lstm[i].g_b);
+        }
+        check_mirror(pm->weights.joint.out_w, cache.joint.gw_w);
+        check_mirror(pm->weights.joint.enc_w, cache.joint.g_enc_w);
+        check_mirror(pm->weights.joint.enc_b, cache.joint.g_enc_b);
+        check_mirror(pm->weights.joint.pred_w, cache.joint.g_pred_w);
+        check_mirror(pm->weights.joint.pred_b, cache.joint.g_pred_b);
+        check_mirror(pm->weights.joint.out_b, cache.joint.gw_b);
+        const auto * embedding = pm->weights.predictor.embed_w;
+        const auto   expected  = decode_original(embedding);
+        CHECK(cache.predictor.embed_type == embedding->type);
+        CHECK(cache.predictor.embed_w.size() == ggml_nbytes(embedding));
+        const size_t       row_bytes = ggml_row_size(embedding->type, hp.pred_hidden);
+        std::vector<float> row(static_cast<size_t>(hp.pred_hidden));
+        for (int i = 0; i < hp.pred_vocab; ++i) {
+            const auto * encoded = cache.predictor.embed_w.data() + static_cast<size_t>(i) * row_bytes;
+            if (embedding->type == GGML_TYPE_F32) {
+                std::memcpy(row.data(), encoded, row.size() * sizeof(float));
+            } else {
+                ggml_get_type_traits(embedding->type)->to_float(encoded, row.data(), hp.pred_hidden);
+            }
+            CHECK(std::memcmp(expected.data() + static_cast<size_t>(i) * row.size(), row.data(),
+                              row.size() * sizeof(float)) == 0);
+        }
+    }
