+void set_relative_positions(ggml_tensor * tensor, int zero_index) {
+    GGML_ASSERT(tensor->type == GGML_TYPE_F32 && ggml_is_contiguous(tensor) && ggml_n_dims(tensor) <= 2);
+    const int64_t      width     = tensor->ne[0];
+    const int64_t      rows      = tensor->ne[1];
+    const int64_t      tile_rows = std::min(rows, std::max<int64_t>(1, 65536 / width));
+    std::vector<float> tile(static_cast<size_t>(tile_rows * width), 0.0f);
+    std::vector<float> div_term(static_cast<size_t>(width / 2));
+    const float        ln_10000 = std::log(10000.0f);
+    for (int64_t k = 0; k < width / 2; ++k) {
+        div_term[static_cast<size_t>(k)] =
+            std::exp(static_cast<float>(2 * k) * (-ln_10000 / static_cast<float>(width)));
+    }
+    for (int64_t base = 0; base < rows; base += tile_rows) {
+        const int64_t count = std::min(tile_rows, rows - base);
+        for (int64_t i = 0; i < count; ++i) {
+            const float pos = static_cast<float>(zero_index - (base + i));
+            float *     row = tile.data() + i * width;
+            for (int64_t k = 0; k < width / 2; ++k) {
+                const float div = div_term[static_cast<size_t>(k)];
+                row[2 * k]      = std::sin(pos * div);
+                row[2 * k + 1]  = std::cos(pos * div);
+            }
+        }
+        ggml_backend_tensor_set(tensor, tile.data(), static_cast<size_t>(base * width) * sizeof(float),
+                                static_cast<size_t>(count * width) * sizeof(float));
+    }
+}
