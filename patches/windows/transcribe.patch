+void test_lookup_lifecycle() {
+    transcribe::Tokenizer tok;
+    for (int count : { 7, 8192, 4, 32769 }) {
+        std::vector<std::string> vocab;
+        for (int i = 0; i < count; ++i) {
+            vocab.push_back(std::to_string(i) + std::string(i % 47, 'x'));
+        }
+        vocab[0] = "";
+        vocab[1] = std::string("a\0b", 3);
+        vocab[2] = "\xc4\x8d\xc5\xa1\xc5\xbe";
+        vocab.push_back(vocab[0]);
+        vocab.push_back(vocab[1]);
+        vocab.push_back(vocab[count - 1]);
+        CHECK(tok.load_decode_only_raw_bytes(vocab) == TRANSCRIBE_OK);
+        auto copied = tok;
+        auto moved  = std::move(copied);
+        CHECK(tok.load_decode_only_raw_bytes({ "replacement" }) == TRANSCRIBE_OK);
+        CHECK(tok.find(vocab[count - 1]) == -1);
+        tok = moved;
+        for (int i = 0; i < count; ++i) {
+            CHECK(tok.find(vocab[i]) == i);
+            CHECK(moved.find(vocab[i]) == i);
+            CHECK(tok.find(vocab[i] + "missing") == -1);
+        }
+        CHECK(tok.find("not in vocabulary") == -1);
+    }
+}
