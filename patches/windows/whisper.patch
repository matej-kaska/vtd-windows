+#ifdef _WIN32
+void strip_shader_debug(std::string& data) {
+    if (data.size() < 20 || data.size() % sizeof(uint32_t)) {
+        throw std::runtime_error("Invalid SPIR-V size");
+    }
+    size_t output = 20;
+    for (size_t input = 20; input < data.size();) {
+        uint32_t word;
+        memcpy(&word, data.data() + input, sizeof(word));
+        const size_t bytes = size_t(word >> 16) * sizeof(word);
+        if (bytes < sizeof(word) || bytes > data.size() - input) {
+            throw std::runtime_error("Invalid SPIR-V instruction");
+        }
+        const auto op = word & 0xffff;
+        if (op < 2 || op > 6) {
+            memmove(data.data() + output, data.data() + input, bytes);
+            output += bytes;
+        }
+        input += bytes;
+    }
+    data.resize(output);
+}
+
+std::string compress_shader(const std::string& data) {
+    COMPRESSOR_HANDLE handle;
+    if (!CreateCompressor(COMPRESS_ALGORITHM_XPRESS_HUFF, nullptr, &handle)) {
+        throw std::runtime_error("Cannot create shader compressor");
+    }
+    std::unique_ptr<std::remove_pointer_t<COMPRESSOR_HANDLE>, decltype(&CloseCompressor)> compressor(handle, CloseCompressor);
+    DWORD level = 1;
+    if (!SetCompressorInformation(handle, COMPRESS_INFORMATION_CLASS_LEVEL, &level, sizeof(level))) {
+        throw std::runtime_error("Cannot set shader compression level");
+    }
+    SIZE_T size = 0;
+    if (Compress(handle, data.data(), data.size(), nullptr, 0, &size) || GetLastError() != ERROR_INSUFFICIENT_BUFFER) {
+        throw std::runtime_error("Cannot size compressed shader");
+    }
+    std::string packed(size + sizeof(uint32_t), '\0');
+    if (!Compress(handle, data.data(), data.size(), packed.data() + sizeof(uint32_t), size, &size) || size > UINT32_MAX) {
+        throw std::runtime_error("Cannot compress shader");
+    }
+    uint32_t length = static_cast<uint32_t>(size);
+    memcpy(packed.data(), &length, sizeof(length));
+    packed.resize(size + sizeof(length));
+    return packed;
+}
