     int32_t n_mel;
     int32_t n_fft;

+    struct band { int begin, end, offset; };
+    std::vector<band> bands;
     std::vector<float> data;
+
+    void compact() {
+        bands.reserve(n_mel);
+        int offset = 0;
+        for (int row = 0; row < n_mel; ++row) {
+            const float * values = data.data() + row * n_fft;
+            const auto zero = [](float v) { return v == 0.0f && !std::signbit(v); };
+            int begin = 0, end = n_fft;
+            while (begin < end && zero(values[begin])) ++begin;
+            while (end > begin && zero(values[end - 1])) --end;
+            if (begin == end) {
+                begin = end = 0;
+            } else {
+                begin = begin / 4 * 4;
+                end = std::min(n_fft, (end + 3) / 4 * 4);
+            }
+            bands.push_back({begin, end, offset});
+            memmove(data.data() + offset, values + begin, (end - begin) * sizeof(float));
+            offset += end - begin;
+        }
+        data.resize(offset);
+        data.shrink_to_fit();
+    }
 };

